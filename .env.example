# Report Pilot's Supabase project (same project; least-privilege m039_app credential)
SUPABASE_URL=https://cjmdmvpbgmqwguakylci.supabase.co
SUPABASE_ANON_KEY=            # apikey header only (from Supabase project settings)
SUPABASE_M039_JWT=             # role=m039_app JWT (see docs/SETUP.md step 3)
SECRET_STORE_KEY=             # stable random string; signs cookies + encrypts stored tokens
OWNER_USER=owner
OWNER_PASSWORD=               # the brand owner's login (app refuses to boot if empty)
REPORT_PILOT_BASE=https://api.tidjaruad.co
NODE_ENV=production           # DON'T set this on Vercel — Vercel sets NODE_ENV + VERCEL itself
CRON_SECRET=                  # Vercel only: any long random string; guards /api/cron/sync (daily sync)
# REPORT_PILOT_KEY=           # optional: rpt_ token (else paste it once in the Setup tab)
# REPORT_PILOT_CLIENT_ID=     # optional override; else resolved from /clients/
